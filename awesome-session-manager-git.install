post_install() {
    cat <<'EOF'
==> awesome-session-manager installed.

    Select "awesomewm-session" in your display manager (e.g. LightDM).
    Existing user sessions may need: systemctl --user daemon-reload
    Optional XDG autostart:          systemctl --user add-wants awesome-session.target xdg-desktop-autostart.target
EOF
}

post_upgrade() {
    post_install
}
